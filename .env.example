# Strike
STRIKE_API_URL=https://api.strikefinance.org
# Optional: the streams default to STRIKE_API_URL's host (/ws/user-api and /ws/price)
# STRIKE_WS_USER_URL=wss://api.strikefinance.org/ws/user-api
# STRIKE_WS_PRICE_URL=wss://api.strikefinance.org/ws/price
# Builder code registered on Strike's Builder Dashboard (Locke's is LockeIn)
STRIKE_BUILDER_CODE=
# Required. Fee per order in bps, a whole number from 0 to STRIKE_BUILDER_MAX_BPS. Each user's
# connect records this as their fee share; orders never carry more than the user agreed to.
STRIKE_BUILDER_FEE_BPS=5
# The maximum fee registered for the builder code (LockeIn: 20). The fee above can't exceed it.
STRIKE_BUILDER_MAX_BPS=20

# Cardano network the wallet must be on: 1 = mainnet, 0 = preprod (use with the testnet API)
NEXT_PUBLIC_CARDANO_NETWORK_ID=1
KOIOS_URL=https://api.koios.rest/api/v1

# Postgres (Supabase pooler URL works). Run `npm run db:migrate` once.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/locke
# Connections per process (serverless functions should stay small)
DATABASE_POOL_MAX=3
# Prepared statements are off automatically on a transaction pooler (port 6543); set false to force off
# DATABASE_PREPARE=false

# 32 bytes, hex (64 chars). Encrypts each user's Strike API wallet key. openssl rand -hex 32
LOCKE_KEY_ENC=
# 32+ random bytes for session cookies. openssl rand -hex 32
SESSION_SECRET=

# Public URL of the app; accepted as a same-origin source for state-changing requests.
# Netlify sets URL and DEPLOY_PRIME_URL itself.
NEXT_PUBLIC_SITE_URL=https://trylocke.online

# Worker only: port for the /healthz endpoint (Railway sets PORT)
PORT=8080

# Demo setting: lowers Locke's alert levels so the alert flow can be shown without a real price move
LOCKE_DEMO_ALERTS=false
