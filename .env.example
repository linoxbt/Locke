# Postgres (Supabase pooler URL works). Run `npm run db:migrate` once.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/locke
# Connections per process (serverless functions should stay small)
DATABASE_POOL_MAX=3
# Prepared statements are off automatically on a transaction pooler (port 6543); set false to force off
# DATABASE_PREPARE=false

# 32+ random bytes for session cookies. openssl rand -hex 32
SESSION_SECRET=

# Public URL of the app; accepted as a same-origin source for state-changing requests.
# Netlify sets URL and DEPLOY_PRIME_URL itself.
NEXT_PUBLIC_SITE_URL=https://trylocke.online

# Vaults on Base, hedged on Avantis (Veranta). Creating vaults is off until BASE_FACTORY_ADDRESS is set.
# The deployed LockeVaultFactory (contracts/). Unset: /base shows "not live yet".
# BASE_FACTORY_ADDRESS=0x...
# Base RPC (default https://mainnet.base.org). Veranta's test network: https://devnet-rpc.veranta.xyz
# BASE_RPC_URL=https://mainnet.base.org
# Locke's Builder Code from the Base dashboard; appended to every Base transaction (ERC-8021)
# BASE_BUILDER_CODE=bc_...
# Keeper only: its private key (0x + 64 hex). It can trade vaults within their limits, never withdraw.
# Fund it with a little ETH on Base for gas.
# BASE_KEEPER_PRIVATE_KEY=0x...
# Keeper only: port for its /healthz endpoint (Railway sets PORT)
PORT=8080
# Veranta endpoints (defaults shown)
# VERANTA_API_URL=https://prod-api.veranta.xyz
# VERANTA_FEED_URL=https://feed-v3.veranta.xyz

# Proofs signed by earlier keeper keys still show as Locke's (comma-separated).
# BASE_PAST_KEEPERS=0x...,0x...

# Agent API (x402). Unset X402_PAY_TO: paid calls answer 503.
# X402_PAY_TO=0x...                 # receives agent payments (USDC on Base)
# X402_SETTLER_PRIVATE_KEY=0x...    # gas wallet that settles payments (a little ETH, no USDC)
# X402_FACILITATOR_URL=https://...  # optional hosted facilitator instead of settling locally

# Alerts for whoever runs Locke (keeper problems, plans near liquidation, keeper down). Telegram:
# a bot from @BotFather and the chat it should write to. Email: a Resend API key; without
# ALERT_EMAIL_FROM it sends from onboarding@resend.dev, which only reaches the Resend account's own address.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Alerts for each business about its own plans (Account page). Telegram uses the bot above: set
# TELEGRAM_WEBHOOK_SECRET and point the bot's webhook at /api/telegram/webhook with it. Email needs a
# sender on a domain verified with Resend, e.g. "Locke <alerts@mail.trylocke.online>".
TELEGRAM_BOT_USERNAME=trylockebot
TELEGRAM_WEBHOOK_SECRET=
USER_EMAIL_FROM=
