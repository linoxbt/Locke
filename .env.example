# Strike
STRIKE_API_URL=https://api.strikefinance.org
STRIKE_WS_USER_URL=wss://api.strikefinance.org/ws/user-api
STRIKE_WS_PRICE_URL=wss://api.strikefinance.org/ws/price
STRIKE_BUILDER_CODE=
# Fee per order in bps; must be <= the fee share registered on the Builder Dashboard (max 100)
STRIKE_BUILDER_FEE_BPS=5

# Cardano network the wallet must be on: 1 = mainnet, 0 = preprod (use with the testnet API)
NEXT_PUBLIC_CARDANO_NETWORK_ID=1
KOIOS_URL=https://api.koios.rest/api/v1

# Postgres (Supabase pooler URL works). Run `npm run db:migrate` once.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/locke

# 32 bytes, hex (64 chars). Encrypts each user's Strike API wallet key. openssl rand -hex 32
LOCKE_KEY_ENC=
# 32+ random bytes for session cookies. openssl rand -hex 32
SESSION_SECRET=

# Demo setting: lowers Locke's alert levels so the alert flow can be shown without a real price move
LOCKE_DEMO_ALERTS=false
