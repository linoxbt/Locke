{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "echo 'no build: the keeper runs from source with tsx'" },
  "deploy": {
    "startCommand": "npx tsx worker/base-keeper.ts",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
